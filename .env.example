# Copy to .env.local for local dev, and set the same vars in Vercel (Project →
# Settings → Environment Variables). Both are safe to expose to the browser —
# the anon key is public and data is protected by row-level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
